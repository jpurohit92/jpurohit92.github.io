---
import Icon from './Icon.astro';
import { formatDate, readingLabel, type ListingItem } from '../lib/posts';

// A post on this site, or a link to content published elsewhere (opens in a new tab).
interface Props { post: ListingItem; as?: 'h2' | 'h3'; showTags?: boolean; }
const { post, as: Heading = 'h2', showTags = true } = Astro.props;
const { title, description, date, category, tags, href, external, source, minutes } = post;
---
<li class="post-item" data-category={category ?? ''} data-tags={tags.join('|')}>
  <p class="post-meta">
    {category && <span class="cat"><Icon name="tag" />{category}</span>}
    <span class="meta-item"><Icon name="calendar" /><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></span>
    {external
      ? <span class="meta-item"><Icon name="link-external" />{source}</span>
      : minutes && <span class="meta-item"><Icon name="clock" />{readingLabel(minutes)}</span>}
  </p>
  <Heading>
    <a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
      {title}
      {external && <Icon name="link-external" class="ext" />}
      {external && <span class="sr-only"> (opens in a new tab)</span>}
    </a>
  </Heading>
  <p>{description}</p>
  {showTags && tags.length > 0 && (
    <ul class="tags" aria-label="Tags" style="list-style:none;margin:0;padding:0">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
  )}
</li>
