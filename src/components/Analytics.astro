---
// Google Analytics 4. Renders nothing unless PUBLIC_GA_MEASUREMENT_ID (e.g. "G-XXXXXXXXXX") is set
// at build time, so local and un-configured builds stay free of third-party scripts.
// See docs/SEO.md for how to set it in GitHub Actions.
const id = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>}
{id && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', id);
  </script>
)}
