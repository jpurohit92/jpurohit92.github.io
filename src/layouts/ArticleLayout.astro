---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ReadingPrefs from '../components/ReadingPrefs.astro';
import ReadingHint from '../components/ReadingHint.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingLabel } from '../lib/posts';
import { SITE, url } from '../site';
import { absoluteUrl, blogPostingSchema, breadcrumbSchema, canonicalFor, graph } from '../lib/seo';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category?: string;
  author?: string;
  seoTitle?: string;
  /** Absolute canonical override (post first published elsewhere). */
  canonical?: string;
  noindex?: boolean;
  /** Social/schema image: a built, base-prefixed URL plus its alt text. */
  cover?: { src: string; alt?: string; width: number; height: number };
  minutes: number;
  headings: MarkdownHeading[];
}
const { title, description, date, updated, tags, category, author = SITE.name, seoTitle, canonical, noindex, cover, minutes, headings } = Astro.props;

// Show "On this page" whenever the article has at least one H2/H3 to navigate to.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 1;
const showUpdated = updated && updated.valueOf() > date.valueOf();

// Share links use this page's own URL; the <link rel="canonical"> may point elsewhere (canonical override).
const pageUrl = canonicalFor(Astro.url.pathname);
const image = cover && absoluteUrl(cover.src);
// JSON-LD only states what is on the page: dateModified only when `updated` is set, image only when a cover exists.
const jsonLd = graph(
  blogPostingSchema({
    headline: title,
    description,
    pageUrl: canonical ?? pageUrl,
    datePublished: date,
    dateModified: showUpdated ? updated : undefined,
    author,
    image,
    section: category,
    keywords: tags,
  }),
  breadcrumbSchema([
    { name: 'Home', path: url('/') },
    { name: 'Blog', path: url('/blog/') },
    { name: title, path: pageUrl },
  ]),
);
---
<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  canonical={canonical}
  noindex={noindex}
  type="article"
  publishedTime={date}
  modifiedTime={showUpdated ? updated : undefined}
  section={category}
  tags={tags}
  image={cover && { url: image!, alt: cover.alt, width: cover.width, height: cover.height }}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <div class:list={['article-layout', { 'has-toc': hasToc }]}>
    <!-- Left column (sticky on wide screens): navigation, title, summary and metadata. -->
    <div class="article-head">
      <div class="article-top">
        <a class="article-back" href={url('/blog/')}><Icon name="arrow-left" /> All writing</a>
      </div>
      <div class="article-head-body">
        <header class="article-header">
          <h1 class="article-title" id="article-title">{title}</h1>
          <p class="article-dek">{description}</p>
          <div class="article-meta">
            {category && <span class="cat"><Icon name="tag" /><a href={`${url('/blog/')}?category=${encodeURIComponent(category)}`}>{category}</a></span>}
            <span class="meta-item">
              <Icon name="person" />By {author === SITE.name ? <a href={url('/about/')}>{author}</a> : author}
            </span>
            <span class="meta-item">
              <Icon name="calendar" /><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
            </span>
            {showUpdated && (
              <span class="meta-item"><Icon name="history" />Updated <time datetime={updated!.toISOString().slice(0, 10)}>{formatDate(updated!)}</time></span>
            )}
            <span class="meta-item"><Icon name="clock" />{readingLabel(minutes)}</span>
          </div>
          {tags.length > 0 && (
            <ul class="article-tags" aria-label="Tags">
              {tags.map((t) => <li class="tag"><a href={`${url('/blog/')}?tag=${encodeURIComponent(t)}`}>{t}</a></li>)}
            </ul>
          )}
        </header>
        {hasToc && <TableOfContents headings={tocHeadings} variant="mobile" />}
      </div>
    </div>

    <!-- Centre column: only this scrolls on wide screens. -->
    <article class="article-main" aria-labelledby="article-title">
      <div class="article-tools">
        <ShareButtons title={title} url={pageUrl} />
        <ReadingPrefs />
      </div>
      <!-- Reading mode only: the left column is blurred, so repeat the title at the top of the card (decorative copy). -->
      <div class="reading-title" aria-hidden="true" data-nosnippet>
        <div class="reading-title__inner"><p class="reading-title__text">{title}</p></div>
      </div>
      <div class="prose" id="article-body"><slot /></div>
    </article>
    {hasToc && <TableOfContents headings={tocHeadings} variant="desktop" />}
  </div>
  <ReadingHint />
  <div id="copy-status" class="copy-status" role="status" aria-live="polite"></div>
  <script>
    import '../scripts/article.ts';
  </script>
</BaseLayout>
