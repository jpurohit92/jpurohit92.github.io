---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ReadingPrefs from '../components/ReadingPrefs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, readingLabel } from '../lib/posts';
import { SITE, url } from '../site';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  category?: string;
  minutes: number;
  headings: MarkdownHeading[];
}
const { title, description, date, updated, tags, category, minutes, headings } = Astro.props;

// Show "On this page" whenever the article has at least one H2/H3 to navigate to.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 1;
const showUpdated = updated && updated.valueOf() > date.valueOf();

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: new URL(url('/about/'), Astro.site).href },
  mainEntityOfPage: pageUrl,
  image: new URL(url('/profile.jpg'), Astro.site).href,
  ...(category ? { articleSection: category } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
---
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date}
  modifiedTime={updated ?? date}
  tags={tags}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <div class:list={['article-layout', { 'has-toc': hasToc }]}>
    <!-- Left column (sticky on wide screens): navigation, title, summary and metadata. -->
    <div class="article-head">
      <div class="article-top">
        <a class="article-back" href={url('/blog/')}><Icon name="arrow-left" /> All writing</a>
        <ReadingPrefs />
      </div>
      <div class="article-head-body">
        <header class="article-header">
          <h1 class="article-title" id="article-title">{title}</h1>
          <p class="article-dek">{description}</p>
          <div class="article-meta">
            {category && <span class="cat"><Icon name="tag" />{category}</span>}
            <span class="meta-item">
              <Icon name="calendar" /><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
            </span>
            {showUpdated && (
              <span class="meta-item"><Icon name="history" />Updated <time datetime={updated!.toISOString().slice(0, 10)}>{formatDate(updated!)}</time></span>
            )}
            <span class="meta-item"><Icon name="clock" />{readingLabel(minutes)}</span>
          </div>
          {tags.length > 0 && (
            <ul class="article-tags" aria-label="Tags">
              {tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          )}
        </header>
        {hasToc && <TableOfContents headings={tocHeadings} variant="mobile" />}
      </div>
    </div>

    <!-- Centre column: only this scrolls on wide screens. -->
    <article class="article-main" aria-labelledby="article-title">
      <div class="prose" id="article-body"><slot /></div>
    </article>
    {hasToc && <TableOfContents headings={tocHeadings} variant="desktop" />}
  </div>
  <div id="copy-status" class="copy-status" role="status" aria-live="polite"></div>
  <script>
    import '../scripts/article.ts';
  </script>
</BaseLayout>
