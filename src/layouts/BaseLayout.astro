---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type. Use "article" for blog posts. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Structured data (JSON-LD) to embed in <head>. */
  jsonLd?: Record<string, unknown>;
}
const { title, description = SITE.description, type = 'website', publishedTime, modifiedTime, tags = [], jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('/profile.jpg'), Astro.site);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.name} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Apply saved theme (or system preference) and reading preferences before
      // first paint, so nothing flashes or shifts.
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          root.setAttribute('data-theme', t);
          var r = JSON.parse(localStorage.getItem('reading') || '{}');
          if (r.size) root.setAttribute('data-size', r.size);
          if (r.width) root.setAttribute('data-width', r.width);
        } catch (e) {}
        // Home shell typing: skipped only for reduced-motion users.
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('js-typewriter');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="bg" aria-hidden="true"><span class="o1"></span><span class="o2"></span><span class="o3"></span></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
