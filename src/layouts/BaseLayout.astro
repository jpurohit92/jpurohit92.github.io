---
import '../styles/global.css';
// Preload the Latin subset of the body font (the only Inter file most pages need) so text renders
// in the final font sooner. Vite resolves this to the same hashed file the CSS uses.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import type { ComponentProps } from 'astro/types';
import { url } from '../site';
import { SEO } from '../lib/seo-config.mjs';

// SEO props are documented on components/Seo.astro.
type Props = ComponentProps<typeof Seo>;
const seo = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SEO.siteName} href={url('/rss.xml')} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <Analytics />

    <script is:inline>
      // Apply saved theme (or system preference) and reading preferences before
      // first paint, so nothing flashes or shifts.
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          root.setAttribute('data-theme', t);
          var r = JSON.parse(localStorage.getItem('reading') || '{}');
          if (r.size) root.setAttribute('data-size', r.size);
          if (r.width) root.setAttribute('data-width', r.width);
        } catch (e) {}
        // Home shell typing: skipped only for reduced-motion users.
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('js-typewriter');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="bg" aria-hidden="true"><span class="o1"></span><span class="o2"></span><span class="o3"></span></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
