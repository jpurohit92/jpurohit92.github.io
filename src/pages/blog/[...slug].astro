---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags, category, author, seoTitle, canonical, noindex, cover, coverAlt } = post.data;
// Social image: the post's cover (cropped to the 1200x630 preview size), otherwise the site default.
const social = cover
  ? await getImage({ src: cover, width: 1200, height: 630, format: 'jpg', quality: 80 })
  : undefined;
---
<ArticleLayout
  title={title}
  description={description}
  date={date}
  updated={updated}
  tags={tags}
  category={category}
  author={author}
  seoTitle={seoTitle}
  canonical={canonical}
  noindex={noindex}
  cover={social && { src: social.src, alt: coverAlt, width: 1200, height: 630 }}
  minutes={readingMinutes(post.body)}
  headings={headings}
>
  <Content />
</ArticleLayout>
